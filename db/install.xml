<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/edukav/db"
       VERSION="2026091501"
       COMMENT="Tablas del plugin local edukav">

    <TABLES>

        <!-- FAQs -->
        <TABLE NAME="edukav_faqs" COMMENT="Preguntas frecuentes">
            <FIELDS>
            <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
            <FIELD NAME="question" TYPE="char" LENGTH="255" NOTNULL="true"/>
            <FIELD NAME="answer" TYPE="text" NOTNULL="true"/>
            <FIELD NAME="visible" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
            <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
            <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

        <!-- Tutorials -->
        <TABLE NAME="edukav_tutorials" COMMENT="Tutoriales">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="description" TYPE="text"/>
                <FIELD NAME="url" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>


        <!-- Contacts -->
       <TABLE NAME="edukav_contacts" COMMENT="Mensajes de contacto">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true"/>
                <FIELD NAME="email" TYPE="char" LENGTH="100" NOTNULL="true"/>
                <FIELD NAME="subject" TYPE="char" LENGTH="255"/>
                <FIELD NAME="message" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>


        <!-- FAQs Users -->
        <TABLE NAME="edukav_faqs_users" COMMENT="Preguntas enviadas por usuarios">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="question" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

        <!-- Partners -->
        <TABLE NAME="edukav_partners" COMMENT="Partners de Edukav">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="slug" TYPE="char" LENGTH="100" NOTNULL="true"/>
                <FIELD NAME="logo" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="brand_color" TYPE="char" LENGTH="7" NOTNULL="false"/>
                <FIELD NAME="visible" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="slug_uix" TYPE="unique" FIELDS="slug"/>
            </KEYS>
        </TABLE>

        <!-- Course library resources -->
        <TABLE NAME="edukav_course_library" COMMENT="Resources assigned to each Edukav course library">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="category" TYPE="char" LENGTH="100" NOTNULL="false"/>
                <FIELD NAME="resourcetype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="document"/>
                <FIELD NAME="level" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="basic"/>
                <FIELD NAME="externalurl" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="featured" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="visible" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="coursevisible_idx" UNIQUE="false" FIELDS="courseid, visible"/>
                <INDEX NAME="coursetype_idx" UNIQUE="false" FIELDS="courseid, resourcetype"/>
            </INDEXES>
        </TABLE>

    </TABLES>
</XMLDB>
